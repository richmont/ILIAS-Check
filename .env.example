# Copy to a private path such as /opt/ilias/data/ilias.env.
# Replace placeholders locally; never commit the resulting file.
ILIAS_BASE_URL=https://ilias.example.edu
ILIAS_CLIENT_ID=replace-with-your-ilias-client-id
ILIAS_USER=replace-with-your-ilias-username
ILIAS_PASS=replace-with-your-ilias-password
ILIAS_PENDING_ROOTS=123456

# Optional bounded traversal settings:
ILIAS_TIMEOUT_SECONDS=20
ILIAS_PENDING_MAX_DEPTH=12
ILIAS_PENDING_MAX_REQUESTS=500

# Optional classification settings (use the installation's timezone):
# ILIAS_TIMEZONE=Europe/Berlin
ILIAS_PENDING_EXCLUDE_EXERCISES=
# Named alternatives exclude only unselected members, never unrelated work:
ILIAS_PENDING_ALTERNATIVE_SETS={}
# Example: {"synthetic-group":{"members":["2001","2002"],"selected":["2001"]}}

# Optional same-folder material metadata; unknown roles remain unselected:
ILIAS_PENDING_INCLUDE_CONTEXTUAL=false

# Optional private support cache (outside every source checkout)
ILIAS_PENDING_DOWNLOAD_SUPPORT=false
ILIAS_PENDING_OUTPUT_DIR=/opt/ilias/data/support
ILIAS_SUPPORT_MAX_FILE_BYTES=20971520
ILIAS_SUPPORT_MAX_RUN_BYTES=104857600
ILIAS_SUPPORT_REVALIDATE_HOURS=12
# Host-only capacity: decimal 200 MB. Never editable through the bot.
ILIAS_SUPPORT_CACHE_MAX_BYTES=200000000
ILIAS_SUPPORT_NO_DEADLINE_TTL_HOURS=168
ILIAS_SUPPORT_RETENTION_MAX_HOURS=

# Scheduled notifications: credentials/destination are supplied by the host.
# Enabling messages does not authorize course attachments.
ILIAS_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
ILIAS_TELEGRAM_SEND_DOCUMENTS=false
ILIAS_TELEGRAM_MAX_DOCUMENT_BYTES=20971520
ILIAS_TELEGRAM_MAX_MESSAGE_CHARS=4000
ILIAS_MONITOR_STATE_DIR=/opt/ilias/data/monitor
# 0 disables reminders; unchanged activities otherwise alert only on changes.
ILIAS_PENDING_REMINDER_HOURS=0
