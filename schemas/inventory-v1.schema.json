{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ilias-check/inventory-v1.schema.json",
  "title": "ILIAS-Check repository inventory",
  "type": "object",
  "required": [
    "schema_version",
    "checked_at",
    "scope",
    "coverage",
    "objects",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "scope": {
      "type": "object",
      "required": ["base_url", "client_id", "root_ids"],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "root_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "complete",
          "empty",
          "objects_discovered",
          "warnings"
        ],
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "complete": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          },
          "objects_discovered": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "error": {
            "type": "object",
            "required": ["category", "object_id"],
            "properties": {
              "category": {
                "type": "string"
              },
              "object_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "type_code",
          "title",
          "instructions",
          "paths",
          "url",
          "url_kind",
          "documents",
          "sequence_resolution",
          "sequence_steps",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "type_code": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": ["string", "null"]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["root_id", "path"],
              "properties": {
                "root_id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "url_kind": {
            "enum": ["activity", "sequence_entry"]
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref_id", "title", "url"],
              "properties": {
                "ref_id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              },
              "additionalProperties": false
            }
          },
          "sequence_resolution": {
            "type": ["string", "null"],
            "enum": ["resolved", "unresolved", null]
          },
          "sequence_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref_id", "type", "title", "url", "url_kind"],
              "properties": {
                "ref_id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "url_kind": {
                  "enum": ["activity", "sequence_entry"]
                }
              },
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "exercise_id",
          "assignment_id",
          "title",
          "submission_type",
          "applicability",
          "availability",
          "status",
          "reason_codes",
          "evidence",
          "deadline_text",
          "deadline_at",
          "url",
          "url_kind",
          "paths",
          "submission_history"
        ],
        "properties": {
          "exercise_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "assignment_id": {
            "type": ["string", "null"],
            "pattern": "^[1-9][0-9]*$"
          },
          "title": {
            "type": "string"
          },
          "submission_type": {
            "enum": ["file_upload", "text", "other", "unknown"]
          },
          "applicability": {
            "enum": ["applicable", "not_applicable", "unknown"]
          },
          "availability": {
            "enum": [
              "accepting_submissions",
              "not_yet_open",
              "closed",
              "unknown"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "submitted",
              "closed_without_submission",
              "not_yet_open",
              "excluded",
              "unknown"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "object",
            "properties": {
              "delivery_confirmed": {
                "type": ["boolean", "null"]
              },
              "acceptance_confirmed": {
                "type": ["boolean", "null"]
              },
              "submission_present": {
                "type": ["boolean", "null"]
              },
              "applicability_source": {
                "type": ["string", "null"]
              },
              "submission_source": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          },
          "deadline_text": {
            "type": ["string", "null"]
          },
          "deadline_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "url": {
            "type": ["string", "null"],
            "format": "uri",
            "pattern": "^https://"
          },
          "url_kind": {
            "enum": ["assignment", "exercise", "sequence_entry"]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "submission_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "submitted_at",
                "attachment_present",
                "attachment_count",
                "scope",
                "approved",
                "completed"
              ],
              "properties": {
                "submitted_at": {
                  "type": ["string", "null"],
                  "format": "date-time"
                },
                "attachment_present": {
                  "type": ["boolean", "null"]
                },
                "attachment_count": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "scope": {
                  "enum": ["personal", "team", "unknown"]
                },
                "approved": {
                  "type": ["boolean", "null"]
                },
                "completed": {
                  "type": ["boolean", "null"]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "root_id", "object_id", "message"],
        "properties": {
          "category": {
            "type": "string"
          },
          "root_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "object_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
